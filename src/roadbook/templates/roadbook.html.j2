{#- emojis, each with its superscript (a count or a climb category), and a "+" when some were left out -#}
{% macro emo(glyphs, more) %}<span class="emo">{% for g in glyphs %}{% if g.dim %}<span class="dim">{% endif %}{{ g.emoji }}{% if g.sup %}<sup>{{ g.sup }}</sup>{% endif %}{% if g.dim %}</span>{% endif %}{% endfor %}{% if more %}+{% endif %}</span>{% endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ book.title }} — road book</title>
<style>
  @page { size: {{ page }} {{ orientation }}; margin: 8mm; }
  :root {
    --w: {{ width }}mm; --l: {{ length }}mm;
    --main-h: {{ g.MAIN_H }}mm; --head-h: {{ g.HEAD_H }}mm; --emo-h: {{ g.EMO_H }}mm; --sub-h: {{ g.SUB_H }}mm; --leg-h: {{ g.LEG_H }}mm;
    --hdr-h: {{ g.HDR_H }}mm; --km-col: {{ g.KM_COL }}mm; --pad: {{ g.PAD }}mm; --gutter: {{ g.GUTTER }}mm;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; font-family: "Segoe UI", "Segoe UI Emoji", "Noto Color Emoji", "Apple Color Emoji", sans-serif; color: #111; }
  .sheet { display: flex; flex-wrap: wrap; gap: 3mm; align-items: flex-start; }
  .sheet > * { break-inside: avoid; flex: none; }
  .emo { font-size: 10pt; line-height: 1; white-space: nowrap; }
  .emo sup { font-size: 5pt; margin-left: 0.2mm; font-weight: 700; }
  .emo .dim { opacity: 0.3; filter: grayscale(1); }  /* every shop of this kind is closed when you pass */
  .km { font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ---------- strip layout: vertical, for the top tube ---------- */
  .strip { width: var(--w); height: var(--l); border: 0.25mm dashed #888; overflow: hidden; font-size: 7.5pt; padding: var(--pad) 0; }
  .strip .hdr { height: var(--hdr-h); margin: calc(-1 * var(--pad)) 0 var(--pad); background: #222; color: #fff; font-size: 6pt;
                display: flex; justify-content: space-between; align-items: center; padding: 0 1.2mm; }
  .row .main { height: var(--main-h); display: flex; align-items: center; gap: 1mm; padding: 0 var(--pad); }
  .row .km { width: calc(var(--km-col) - var(--pad)); text-align: right; flex: none; }
  .row .dist { margin-left: auto; flex: none; font-size: 6pt; color: #555; font-variant-numeric: tabular-nums; }
  .row .lbl { font-size: 6.5pt; font-weight: 700; white-space: nowrap; overflow: hidden; }
  /* a crowded stop's emojis carry on below its main line, lined up under the first one */
  .row .emo-line { height: var(--emo-h); margin-left: var(--km-col); padding-left: 1mm; display: flex; align-items: center; }
  .row .sub { height: var(--sub-h); margin-left: var(--km-col); padding-left: 1mm; font-size: 6.5pt; font-weight: 600; white-space: nowrap; }
  /* heading lines above a row, right-aligned so the km down the left read on undisturbed; cut with "…" only if
     wider than the strip: a busy stop's town in italics, a climb's col or peak upright in the climbs' brown */
  .row .head { height: var(--head-h); padding: 0 var(--pad); display: flex; align-items: flex-end; justify-content: flex-end;
               font-size: 6.5pt; font-weight: 600; color: #333; white-space: nowrap; overflow: hidden; }
  .row .head span { overflow: hidden; text-overflow: ellipsis; }
  .row .head.town { font-style: italic; }
  .row .head.col { font-weight: 700; color: #92400e; }
  /* a climb's gain keeps its place at the right, under the "↓" distances: only its length and grade may be cut */
  .strip .row .sub { display: flex; gap: 1mm; padding-right: var(--pad); }
  .strip .row .sub .fig { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .strip .row .sub .gain { flex: none; margin-left: auto; }
  .row .leg { height: var(--leg-h); margin-left: calc(var(--km-col) + 0.5mm); padding-left: 1.5mm; border-left: 0.5mm solid #777;
              font-size: 6pt; color: #444; white-space: nowrap; display: flex; align-items: center; }
  .row.climb { background: #fbe3c4; }
  .row.summit { background: #fbe3c4; border-bottom: 0.3mm solid #d97706; }
  .row.checkpoint, .row.start, .row.finish { background: #d9e8ff; border-top: 0.2mm solid #345; border-bottom: 0.2mm solid #345; }
  .row.climb .leg, .row.checkpoint .leg { border-left-color: #b45309; }
  .strip { position: relative; }
  .strip .row { margin-right: var(--gutter); }
  .strip .row .sub, .strip .row .leg { overflow: hidden; }
  /* the watermark runs up the left edge, in the blank left of the right-aligned km: it takes no row height */
  .strip .wm { position: absolute; left: 0.05mm; bottom: var(--pad); writing-mode: vertical-rl; transform: rotate(180deg);
               font-size: 3.5pt; line-height: 1; color: #aaa; }
  .strip .gutter { position: absolute; right: 0; top: calc(var(--hdr-h) + var(--pad)); border-left: 0.2mm solid #bbb; }

  /* ---------- line layout: horizontal ribbons, one token per stop ---------- */
  .ribbon { width: var(--l); height: var(--w); border: 0.25mm dashed #888; display: flex; overflow: hidden; }
  .tok { flex: none; display: flex; flex-direction: column; justify-content: space-between; align-items: center; text-align: center;
         padding: 0.8mm; border-right: 0.2mm dotted #999; }
  .tok .km { font-size: 6pt; }
  .tok .leg { font-size: 5.5pt; color: #444; white-space: nowrap; }
  .tok .sub { font-size: 5.5pt; font-weight: 600; white-space: nowrap; }
  .tok.climb, .tok.summit { background: #fbe3c4; }
  .tok.checkpoint, .tok.start, .tok.finish { background: #d9e8ff; }
  .ribbon { position: relative; }
  /* tokens fill at most the length less 2 x --pad: the watermark runs up the spare end */
  .ribbon .wm { position: absolute; right: 0.2mm; top: 0; bottom: 0; writing-mode: vertical-rl; transform: rotate(180deg);
                text-align: center; font-size: 4pt; line-height: 1; color: #aaa; }

  /* ---------- reference sheet ---------- */
  .details { break-before: page; font-size: 7pt; columns: 2; column-gap: 8mm; }
  .details h1 { font-size: 11pt; column-span: all; margin: 0 0 2mm; }
  .details .stop { break-inside: avoid; margin-bottom: 1.6mm; }
  .details .stop b { font-variant-numeric: tabular-nums; }
  .details .off { color: #777; }
  .details .oh { color: #333; font-variant-numeric: tabular-nums; }
  .details .closed, .details .verdict { font-weight: 700; }
  .details .col { color: #92400e; }
  .details .eta { font-variant-numeric: tabular-nums; color: #333; }
  .details .credit, .details .colophon { column-span: all; color: #777; font-size: 6pt; margin: 3mm 0 0; }
  .details .credit + .colophon { margin-top: 0.8mm; }
  .details .colophon a { color: inherit; text-decoration: none; }
  @media screen { body { padding: 8mm; background: #eee; } .strip, .ribbon { background: #fff; } }
</style>
</head>
<body>
<div class="sheet">
{% if layout == 'strip' %}
  {% for s in strips %}
  <div class="strip"{% if s.over %} style="height: calc(var(--l) + {{ '%.1f' % s.over }}mm)"{% endif %}>
    <div class="hdr"><span>km {{ s.first }} → {{ s.last }}</span><span>{{ loop.index }}/{{ loop.length }}</span></div>
    {% for r in s.rows %}
    <div class="row {{ r.kind }}">
      {% for h in r.heads %}<div class="head {{ h.cls }}"><span>{{ h.text }}</span></div>{% endfor %}
      <div class="main">
        <span class="km">{{ r.km }}</span>
        {{ emo(r.emojis, r.more and not r.emoji_lines) }}
        {% if r.label %}<span class="lbl">{{ r.label }}</span>{% endif %}
        {% if r.dist %}<span class="dist">{{ r.dist }}</span>{% endif %}
      </div>
      {%- for line in r.emoji_lines %}
      <div class="emo-line">{{ emo(line, r.more and loop.last) }}</div>
      {%- endfor %}
      {% if r.sub %}<div class="sub"><span class="fig">{{ r.sub }}</span>{% if r.gain %}<span class="gain">{{ r.gain }}</span>{% endif %}</div>{% endif %}
      {% if r.leg %}<div class="leg">{{ r.leg }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if s.gutter %}{{ s.gutter | safe }}{% endif %}
    <span class="wm">{{ tool }}</span>
  </div>
  {% endfor %}
{% else %}
  {% for s in strips %}
  <div class="ribbon"{% if s.over %} style="width: calc(var(--l) + {{ '%.1f' % s.over }}mm)"{% endif %}>
    {% for r in s.rows %}
    <div class="tok {{ r.kind }}" style="width: {{ r.w }}mm">
      <span class="km">{{ r.km }}</span>
      {{ emo(r.emojis, r.more) }}
      {% if r.sub_short %}<span class="sub">{{ r.sub_short }}</span>{% endif %}
      {% if r.gain %}<span class="sub gain">{{ r.gain }}</span>{% endif %}
      {% if r.leg_short %}<span class="leg">{{ r.leg_short }}</span>{% endif %}
    </div>
    {% endfor %}
    <span class="wm">{{ tool }}</span>
  </div>
  {% endfor %}
{% endif %}
</div>

{% if details %}
<div class="details">
  <h1>{{ book.title }} — {{ '%.0f' % book.length_km }} km · ↗️{{ '%.0f' % book.gain_m }} m ↘️{{ '%.0f' % book.loss_m }} m{% if ride %} · {{ ride }}{% endif %}</h1>
  {% for s in details %}
  <div class="stop"><b>km {{ s.km }}{% if s.town %} · {{ s.town }}{% endif %}{% if s.col %} · <span class="col">{{ s.col }}</span>{% endif %}</b>{% if s.eta %} <span class="eta">{{ s.eta }}</span>{% endif %}
    {% for emoji, pois in s.groups %}
    <div>{{ emoji }} {% for p in pois %}{{ p.name }}{% if p.off > 30 %} <span class="off">({{ p.off }} m)</span>{% endif %}{% if p.verdict %} <b class="verdict">{{ p.verdict }}</b>{% endif %}{% if p.hours %} <span class="{{ p.hours_class }}">{{ p.hours }}</span>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% endfor %}
  </div>
  {% endfor %}
  {% if credit %}<p class="credit">{{ credit }} © OpenStreetMap contributors (ODbL).{% if book.hours %} Hours change: check the ones you rely on.{% endif %}</p>{% endif %}
  <p class="colophon">Made with {{ tool }} {{ version }} · <a href="https://{{ home }}">{{ home }}</a></p>
</div>
{% endif %}
</body>
</html>
